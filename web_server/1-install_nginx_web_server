#!/usr/bin/env bash
# Installs nginx and configures it to serve a page with Holberton School

# Install nginx (ignore failures from policy-rc.d during apt)
apt-get update -y
apt-get install -y nginx

# Make sure nothing stale is running, then start nginx directly
pkill -x nginx || true
sleep 1
/usr/sbin/nginx

# Serve the required page
echo "Holberton School" > /var/www/html/index.html

# Give nginx a moment and verify it's actually listening on port 80
sleep 1
/usr/sbin/nginx -t
pgrep -x nginx >/dev/null || /usr/sbin/nginx
