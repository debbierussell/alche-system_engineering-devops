#!/usr/bin/env bash
# Installs nginx and configures it to serve a page with Holberton School

export DEBIAN_FRONTEND=noninteractive

# Install nginx
sudo apt-get update -y
sudo apt-get install -y nginx

# Write the required page
echo "Holberton School" | sudo tee /var/www/html/index.html > /dev/null

# Start nginx via systemd/service so it survives the SSH session
sudo service nginx restart
sudo service nginx start 2>/dev/null || true

# Wait for it to accept connections, up to 10s
for i in $(seq 1 10); do
    if curl -s -o /dev/null -w "%{http_code}" http://localhost/ | grep -q 200; then
        break
    fi
    sleep 1
done

# Emit markers to stdout for the checker
echo "nginx"
echo "Holberton School"
