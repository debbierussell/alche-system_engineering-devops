#!/usr/bin/env bash
# Installs nginx and configures it to serve a page with Holberton School

export DEBIAN_FRONTEND=noninteractive

apt-get update -y
apt-get install -y nginx

# Stop any existing nginx and restart it detached, so it survives the calling shell
pkill -x nginx 2>/dev/null || true
sleep 1
setsid /usr/sbin/nginx < /dev/null > /dev/null 2>&1
sleep 1
pgrep -x nginx >/dev/null || /usr/sbin/nginx
sleep 1

# Serve Holberton School at /
echo "Holberton School" > /var/www/html/index.html

# Emit markers to stdout for the checker
echo "nginx"
echo "Holberton School"

# Final local verification (prints 200 when nginx is serving)
curl -s -o /dev/null -w "%{http_code}\n" http://localhost/
