#!/usr/bin/env bash
# Installs nginx and configures it to serve Holberton School

sudo apt-get update -y
sudo apt-get install -y nginx
sudo service nginx start 2>/dev/null || sudo nginx || sudo /usr/sbin/nginx
echo "Holberton School" | sudo tee /var/www/html/index.html > /dev/null
sudo service nginx reload 2>/dev/null || sudo nginx -s reload
pgrep nginx >/dev/null || sudo nginx
